default_platform(:android)

platform :android do
  # Listing text and images are NOT uploaded from this repo. The live Play listing is edited
  # through the Play API / Play Console; the repo copy of the listing text is store-listing/en-US,
  # a mirror of it (see store-listing/README.md). fastlane supply uploads metadata, images and
  # screenshots unless each one is skipped, so every upload_to_play_store call below keeps skip_upload_metadata,
  # skip_upload_images and skip_upload_screenshots true. Release notes (changelogs) have their
  # own flag, skip_upload_changelogs, and are unaffected.
  desc "Upload the current release AAB to production. Pre-req: the app listing must already exist in Play Console (created manually — the Play Developer API can't create a brand-new app listing) and Data Safety + content rating questionnaires must be completed there first."
  lane :deploy do
    upload_to_play_store(
      track: "production",
      aab: "app/build/outputs/bundle/coreRelease/app-core-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      release_status: "completed"
    )
  end

  desc "Push current AAB to Open Testing (beta) track. Pre-req: Play Console > Testing > Open testing must be enabled for this app."
  lane :promote_to_open_testing do
    upload_to_play_store(
      track: "beta",
      aab: "app/build/outputs/bundle/coreRelease/app-core-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
      release_status: "completed"
    )
  end
end
