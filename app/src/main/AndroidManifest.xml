<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to be eligible for the default SMS/MMS handler role -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- On-device voice memo -> text (whisper.cpp). Audio is transcribed locally and never
         leaves the device. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Optional, off-by-default, behind an explicit consent dialog: connects to
         inboxiq-mcp-backend (mcp.kreativekoala.llc) so the user can add this phone as a Claude
         Connector. When enabled, message text, sender numbers and contact names are sent to
         that service and on to Claude in response to the user's own requests. See mcp/ and
         docs/DIAGNOSIS.md. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- specialUse (no 6h cap, unlike dataSync on Android 15+): a user-initiated, visible
         connection to a service the user chose. Declared in Play Console, see
         docs/FOREGROUND_SERVICE_DECLARATION.md. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Held only while the relay WebSocket is open (see RelayForegroundService). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".InboxIqApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.InboxIQ"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Default SMS app must handle these -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <!-- Delivers incoming SMS to the default handler -->
        <receiver
            android:name=".sms.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Delivers incoming MMS to the default handler -->
        <receiver
            android:name=".sms.MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Buttons on message notifications: Reply, Mark as read, Copy code -->
        <receiver
            android:name=".sms.NotificationActionReceiver"
            android:exported="false" />

        <!-- Sent-SMS status callback -->
        <receiver
            android:name=".sms.SmsSentReceiver"
            android:exported="false" />

        <!-- Sent-MMS status callback (mmslib) -->
        <receiver
            android:name="com.klinker.android.send_message.MmsSentReceiver"
            android:exported="false" />

        <!-- Our own MMS delivery-result receiver — MmsSender redirects mmslib's completion
             broadcast here (see MmsStatusReceiver) since attempt() succeeding only means the
             send was handed off, not confirmed delivered. -->
        <receiver
            android:name=".sms.MmsStatusReceiver"
            android:exported="false" />

        <!-- MMS content-download-result callback (see MmsDownloadWorker/MmsDownloadReceiver) —
             explicitly triggers and confirms the actual multimedia download, since the OS
             doesn't reliably do this on its own despite holding the default-handler role. -->
        <receiver
            android:name=".sms.MmsDownloadReceiver"
            android:exported="false" />

        <!-- Serves our own copies of picked images (see MmsSender.persistLocally) — the
             system Photo Picker's content:// grant doesn't reliably survive being read
             again later (e.g. on a retry), so we own a stable copy instead. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Holds the persistent WebSocket connection to inboxiq-mcp-backend (see
             mcp/RelayForegroundService.kt) — started only from the foreground app UI after the
             user accepts the consent dialog. NOT restarted at boot: Android 12+ blocks
             background foreground-service starts and Android 15 blocks dataSync from
             BOOT_COMPLETED, so the user reopens the app to reconnect. -->
        <service
            android:name=".mcp.RelayForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled, visible connection to the Claude AI connector relay (mcp.kreativekoala.llc); holds one WebSocket open so the user's own Claude session can read and draft messages. Never started in the background or at boot." />
        </service>

        <!-- Default apps that provide RCS messaging must handle this -->
        <service
            android:name=".sms.HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

    </application>
</manifest>
