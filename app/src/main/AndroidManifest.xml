<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to be eligible for the default SMS/MMS handler role -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- On-device voice memo -> text (whisper.cpp). Audio is transcribed locally and never
         leaves the device. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Optional, off-by-default: connects to inboxiq-mcp-backend so this phone can be added
         as a Claude Connector (claude.ai / Desktop) from any device — not LAN-restricted.
         Message content passes through that backend in transit to relay live tool calls; it
         is not stored there. See mcp/ and inboxiq-mcp-backend's README. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- FOREGROUND_SERVICE_DATA_SYNC intentionally omitted for now — RelayForegroundService
         is unreachable while CloudConnectSection is hidden (see MainActivity), and declaring
         this permission requires a Play Console "Foreground service" usage declaration.
         Re-add alongside re-enabling that section. -->
    <!-- Held only while the relay WebSocket is open (see RelayForegroundService), so Doze
         doesn't silently throttle the connection while it still reports as "connected". -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".InboxIqApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.InboxIQ"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Default SMS app must handle these -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <!-- Delivers incoming SMS to the default handler -->
        <receiver
            android:name=".sms.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Delivers incoming MMS to the default handler -->
        <receiver
            android:name=".sms.MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Sent-SMS status callback -->
        <receiver
            android:name=".sms.SmsSentReceiver"
            android:exported="false" />

        <!-- Sent-MMS status callback (mmslib) -->
        <receiver
            android:name="com.klinker.android.send_message.MmsSentReceiver"
            android:exported="false" />

        <!-- Our own MMS delivery-result receiver — MmsSender redirects mmslib's completion
             broadcast here (see MmsStatusReceiver) since attempt() succeeding only means the
             send was handed off, not confirmed delivered. -->
        <receiver
            android:name=".sms.MmsStatusReceiver"
            android:exported="false" />

        <!-- Serves our own copies of picked images (see MmsSender.persistLocally) — the
             system Photo Picker's content:// grant doesn't reliably survive being read
             again later (e.g. on a retry), so we own a stable copy instead. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- RelayForegroundService (mcp/) intentionally not registered here for now — see the
             FOREGROUND_SERVICE_DATA_SYNC comment above. Re-add alongside that permission. -->

        <!-- Default apps that provide RCS messaging must handle this -->
        <service
            android:name=".sms.HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

    </application>
</manifest>
