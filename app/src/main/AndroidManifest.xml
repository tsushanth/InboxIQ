<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to be eligible for the default SMS/MMS handler role -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- On-device voice memo -> text (whisper.cpp). Audio is transcribed locally and never
         leaves the device. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Optional, off-by-default: a local-network-only MCP server (see mcp/) so the user's own
         AI agent (running on their own computer, same wifi) can query/send messages, always
         with a per-send on-device approval. This is the one legitimate reason this app needs
         INTERNET — it binds to the phone's LAN address only (never 0.0.0.0), so it's not
         reachable from the public internet. See docs/mcp-server.md. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".InboxIqApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.InboxIQ"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Default SMS app must handle these -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <!-- Delivers incoming SMS to the default handler -->
        <receiver
            android:name=".sms.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Delivers incoming MMS to the default handler -->
        <receiver
            android:name=".sms.MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Sent-SMS status callback -->
        <receiver
            android:name=".sms.SmsSentReceiver"
            android:exported="false" />

        <!-- Sent-MMS status callback (mmslib) -->
        <receiver
            android:name="com.klinker.android.send_message.MmsSentReceiver"
            android:exported="false" />

        <!-- Serves our own copies of picked images (see MmsSender.persistLocally) — the
             system Photo Picker's content:// grant doesn't reliably survive being read
             again later (e.g. on a retry), so we own a stable copy instead. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Hosts the optional local-network MCP server (see mcp/McpServer.kt) — only ever
             started explicitly from Settings, never on boot. -->
        <service
            android:name=".mcp.McpForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Handles Approve/Deny taps on pairing/send-message notifications (see mcp/ApprovalGate). -->
        <receiver
            android:name=".mcp.ApprovalActionReceiver"
            android:exported="false" />

        <!-- Default apps that provide RCS messaging must handle this -->
        <service
            android:name=".sms.HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

    </application>
</manifest>
